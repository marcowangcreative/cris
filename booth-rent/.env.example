# Copy to .env.local. Never commit real keys.

# Supabase Auth (magic link). When NEXT_PUBLIC_SUPABASE_URL is empty, the app
# runs in demo mode and does not need these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe secret for the salon owner's own account (sandbox or test mode).
# Use a test/sandbox key while this is an MVP. Live keys move money.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Public origin, no trailing slash. Used for magic-link and Stripe return URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode uses the seeded Lumen Room salon and never calls Stripe.
# true  — force demo even if Supabase is configured
# false — require Supabase even if the URL is missing
# unset — demo whenever NEXT_PUBLIC_SUPABASE_URL is empty
NEXT_PUBLIC_DEMO_MODE=
