# Copy to .env.local. Leave a variable blank to keep that feature in demo mode.
# Never commit .env.local. The admin password must not be written into source.

# Staff desk. Required to open /admin. There is no default.
ADMIN_PASSWORD=

# Optional. If unset, the session cookie is signed with ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Public URL of this app, no trailing slash. Used in emails, reminders, and calendar links.
# Checkout return URLs use the incoming request host when this is blank.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe test keys. When STRIPE_SECRET_KEY is blank, checkout is simulated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Postgres or the Supabase connection string. When blank, bookings are stored in data/store.json.
DATABASE_URL=

# Set to false to skip demo bookings on an empty database or a missing store file.
SEED_ON_EMPTY=

# Resend. When RESEND_API_KEY is blank, email is printed to the server log.
RESEND_API_KEY=
RESEND_FROM="Camara Wong <bookings@camarawong.com>"
STUDIO_INBOX=studio@camarawong.com

# Bearer token for /api/cron/reminders. Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=
