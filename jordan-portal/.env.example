# Demo mode is the only mode this public MVP runs.
# Set DEMO_MODE=false only on a private deployment you control.
DEMO_MODE=true

# Signs the demo session cookie and magic links. Replace on any real host.
DEMO_SESSION_SECRET=replace-with-a-long-random-string

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CALENDLY_TRANSFORMATION_URL=https://calendly.com/example/private-transformation

# Calendly webhook signing secret. The sample script uses this same placeholder.
# Never commit a live secret.
CALENDLY_WEBHOOK_SIGNING_SECRET=whsec_demo_only_not_a_real_secret

# Confirmed default, still an owner decision: the 1st opens the month two months ahead.
RELEASE_DAY_OF_MONTH=1
RELEASE_LEAD_MONTHS=2
RELEASE_LOCAL_TIME=09:00

# Included consultation. No fee. Owner still chooses Zoom or Teams.
CONSULTATION_DURATION_MINUTES=30

# Supabase is unused while DEMO_MODE=true. Leave these blank in the public repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
