# Copy to .env. Never commit .env.

# Google Cloud OAuth client (Desktop). Used for every Gmail account.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Loopback port for `npm run auth`. Add http://127.0.0.1:42813 as a
# redirect URI if the client type asks for one.
GOOGLE_REDIRECT_PORT=42813

# Model extractor. Leave blank to use the offline heuristic.
# LLM_PROVIDER: openai | anthropic | openai-compatible
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# For OpenAI-compatible hosts (Groq, OpenRouter, a local server, ...).
# LLM_BASE_URL=https://api.openai.com/v1

# Optional. On a schedule runner, a JSON object keyed by Gmail account id.
# Each value is the token file `npm run auth` wrote (refresh_token included).
# SCHOOL_DIGEST_TOKENS_JSON=
