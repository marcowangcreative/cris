# School digest — Sunday 7:00 PM US Central.
#
# Debian/Ubuntu cron honors CRON_TZ. The digest then runs once, at 7 PM local,
# including across the daylight-saving change.
#
# CRON_TZ=America/Chicago
# 0 19 * * 0 cd /absolute/path/school-digest && /usr/bin/npm run digest -- --deliver file >> /tmp/school-digest.log 2>&1
#
# Portable cron has no timezone field. Run hourly and let --scheduled exit
# unless the clock in America/Chicago says Sunday 7 PM. Sunday evening in
# Chicago is already Monday in UTC, so both Sunday and Monday are listed.
#
# 0 * * * 0,1 cd /absolute/path/school-digest && /usr/bin/npm run digest -- --scheduled --deliver file >> /tmp/school-digest.log 2>&1
