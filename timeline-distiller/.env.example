# Local only. On Vercel, the project OIDC token is used and this can stay unset.
AI_GATEWAY_API_KEY=

# Optional. Any id from https://ai-gateway.vercel.sh/v1/models
# Default: anthropic/claude-haiku-4.5 (structured output, vision, PDF, zero data retention)
AI_GATEWAY_MODEL=

# Optional overrides for the Formals shot-list Supabase project.
# Defaults are the public anon credentials shipped in marcowangcreative/formals.
FORMALS_SUPABASE_URL=
FORMALS_SUPABASE_ANON_KEY=
